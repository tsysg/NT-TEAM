local function listEggs(ignoreFilter)
    local out = {}
    local collected = "," .. tostring(LP:GetAttribute("CollectedEggs") or "") .. ","
    local now = os.clock()
    for _, obj in ipairs(ActiveEggs:GetChildren()) do
        if not (S.failed[obj.Name] and now < S.failed[obj.Name]) then
            local name = obj:GetAttribute("Egg")
            local data = name and Data.Eggs[name]
            local pos = obj:GetAttribute("Position")
            local private = obj:GetAttribute("PrivateTo")
            if data and typeof(pos) == "Vector3" and (not private or private == LP.UserId)
                and not string.find(collected, "," .. obj.Name .. ",", 1, true) then
                local rarity = data.Rarity or "Common"
                local mut = obj:GetAttribute("Mutation") or ""
                local smut = obj:GetAttribute("SpawnMutation") or ""
                local mutated = (mut ~= "" and mut ~= "None") or (smut ~= "" and smut ~= "None")
                local luck = data.Luck or 0
                local ok = ignoreFilter or (luck >= S.minLuck
                    and (RarityOrder[rarity] or 0) >= (RarityOrder[S.minRarity] or 1)
                    and (not S.mutatedOnly or mutated))
                if ok then
                    table.insert(out, {
                        ID = obj.Name, Object = obj, Name = name, Position = pos,
                        Luck = luck, Rarity = rarity, Mutated = mutated,
                        Mutation = mutated and (mut ~= "" and mut or smut) or "Kh\195\180ng",
                    })
                end
            end
        end
    end
    table.sort(out, function(a, b)
        if a.Luck ~= b.Luck then return a.Luck > b.Luck end
        if a.Mutated ~= b.Mutated then return a.Mutated end
        return (RarityOrder[a.Rarity] or 0) > (RarityOrder[b.Rarity] or 0)
    end)
    return out
end

-- =========== Di chuy\225\187\131n: Instant TP ho\225\186\183c Tween ===========
local moveConn, moveTween
local function stopMove()
    if moveConn then pcall(function() moveConn:Disconnect() end) moveConn = nil end
    if moveTween then pcall(function() moveTween:Cancel() end) moveTween = nil end
    local _, hum, root = char()
    if hum then hum.PlatformStand = false hum.AutoRotate = true end
    if root then root.AssemblyLinearVelocity = Vector3.zero root.AssemblyAngularVelocity = Vector3.zero end
end

local function instantTP(target)
    local c, hum, root = char()
    if not root then return false end
    stopMove()

    if S.bypass then
        bpNoclip(true)
        if hum then
            pcall(function()
                hum.PlatformStand = true
                hum.AutoRotate = false
                hum:ChangeState(Enum.HumanoidStateType.Flying)
            end)
        end
        local cf = CFrame.new(target + Vector3.new(0, 3, 0))
        bpSafeCFrame(root, cf)
        -- double-set sau 1 frame (bypass anti-tele revert)
        RunService.Heartbeat:Wait()
        bpSafeCFrame(root, cf)
        RunService.Heartbeat:Wait()
        bpSafeCFrame(root, cf)
        if hum then
            pcall(function()
                hum.PlatformStand = false
                hum.AutoRotate = true
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
        task.delay(0.15, function() bpNoclip(false) end)
        return (root.Position - target).Magnitude <= 18
    end

    -- fallback kh\195\180ng bypass
    local parts = {}
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            parts[p] = p.CanCollide
            p.CanCollide = false
        end
    end
    root.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    RunService.Heartbeat:Wait()
    for p, v in pairs(parts) do
        if p.Parent then pcall(function() p.CanCollide = v end) end
    end
    return true
end

local function moveTo(target, arrive)
    arrive = arrive or 8
    local c, hum, root = char()
    if not root then return false end

    if S.instant then
        return instantTP(target)
    end

    stopMove()
    local dist = (root.Position - target).Magnitude
    if dist <= arrive then return true end

    if S.bypass then bpNoclip(true) end

    local parts = {}
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then parts[p] = p.CanCollide p.CanCollide = false end
    end
    if hum then
        hum.PlatformStand = true
        hum.AutoRotate = false
    end

    local duration = math.max(0.05, dist / math.clamp(S.speed, 50, 10000))
    local goal = CFrame.new(target + Vector3.new(0, 3, 0)) * root.CFrame.Rotation
    moveTween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = goal })
    moveConn = RunService.Stepped:Connect(function()
        if root.Parent then
            for p in pairs(parts) do if p.Parent then p.CanCollide = false end end
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    moveTween:Play()
    local deadline = os.clock() + duration + 3
    while S.alive and S.running and root.Parent and hum and hum.Health > 0 and os.clock() < deadline
        and moveTween and moveTween.PlaybackState == Enum.PlaybackState.Playing do
        task.wait()
    end
    local ok = moveTween and moveTween.PlaybackState == Enum.PlaybackState.Completed
    stopMove()
    for p, v in pairs(parts) do if p.Parent then pcall(function() p.CanCollide = v end) end end
    if S.bypass then
        bpZeroVel(root, 4)
        bpNoclip(false)
    end
    return ok and (root.Position - target).Magnitude <= arrive + 6
end

local function waitFor(pred, secs)
    local t0 = os.clock()
    while os.clock() - t0 < secs and S.alive and S.running do
        if pred() then return true end
        task.wait(0.03)
    end
    return pred()
end

