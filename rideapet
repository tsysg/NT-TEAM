local WindUI
do
    local G = (type(getgenv) == "function" and getgenv()) or {}
    local R = (type(getrenv) == "function" and getrenv()) or {}
    local ls = G.loadstring or R.loadstring or loadstring
    local function fetch(url)
        local okh, body = pcall(function() return game:HttpGet(url, true) end)
        if okh and type(body) == "string" and #body > 100 then return body end
        local req = (type(syn) == "table" and syn.request) or (type(http) == "table" and http.request) or G.request or G.http_request or request or http_request
        if type(req) == "function" then
            local okr, res = pcall(req, { Url = url, Method = "GET" })
            if okr and type(res) == "table" and type(res.Body) == "string" and #res.Body > 100 then return res.Body end
        end
        return nil
    end
    local urls = {
        "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua",
        "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
    }
    local lastErr = "unknown"
    for attempt = 1, 3 do
        for _, url in ipairs(urls) do
            local src = fetch(url)
            if src and type(ls) == "function" then
                local fn, cerr = ls(src)
                if type(fn) == "function" then
                    local okr, res = pcall(fn)
                    if okr and type(res) == "table" then WindUI = res break end
                    lastErr = tostring(res)
                else
                    lastErr = tostring(cerr)
                end
            end
        end
        if WindUI then break end
        task.wait(1)
    end
    if not WindUI then
        warn("[RideAPet] WindUI load fail: " .. lastErr)
