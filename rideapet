local function bpNoclip(enable)
    if Bypass.noclipConn then
        pcall(function() Bypass.noclipConn:Disconnect() end)
        Bypass.noclipConn = nil
    end
    if not enable then return end
    Bypass.noclipConn = RunService.Stepped:Connect(function()
        if not S.alive or not S.bypass then return end
        local c = LP.Character
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end)
    table.insert(S.conns, Bypass.noclipConn)
end

local function bpZeroVel(root, frames)
    frames = frames or 8
    task.spawn(function()
        for _ = 1, frames do
            if root and root.Parent then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

local function bpSafeCFrame(root, cf)
    if not root or not root.Parent then return false end
    -- Nhi\225\187\129u c\195\161ch set v\225\187\139 tr\195\173 \196\145\225\187\131 gi\225\186\163m anti-tele detect
    pcall(function() root.CFrame = cf end)
    pcall(function()
        if root.Parent and root.Parent:IsA("Model") then
            root.Parent:PivotTo(cf)
        end
    end)
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    bpZeroVel(root, 6)
    return true
end

local function installBypasses()
    if Bypass.locked then return end
    Bypass.locked = true

    -- Anti-kick (chi chay neu executor co hookmetamethod)
    pcall(function()
        if type(hookmetamethod) ~= "function" then
            return
        end
        local getnc = nil
        if type(getnamecallmethod) == "function" then
            getnc = getnamecallmethod
        end
        local old
        local ncc = (type(newcclosure) == "function" and newcclosure) or function(f) return f end
        old = hookmetamethod(game, "__namecall", ncc(function(self, ...)
            if type(checkcaller) == "function" and checkcaller() then return old(self, ...) end
            if S.bypass and S.alive then
                local method = ""
                if type(getnc) == "function" then
                    local okm, m = pcall(getnc)
                    if okm and m ~= nil then
                        method = string.lower(tostring(m))
                    end
                end
                if self == LP and (method == "kick" or method == "ban") then
                    return nil
                end
                if typeof(self) == "Instance" then
                    local okc, cn = pcall(function()
                        return self.ClassName
                    end)
                    if okc and cn == "RemoteEvent" then
                        local okn, nm = pcall(function()
                            return string.lower(tostring(self.Name))
                        end)
                        if okn and type(nm) == "string" then
                            if string.find(nm, "kick", 1, true)
                                or string.find(nm, "ban", 1, true)
                                or string.find(nm, "anticheat", 1, true)
                                or string.find(nm, "detect", 1, true)
                                or string.find(nm, "punish", 1, true) then
                                return nil
                            end
                        end
                    end
                end
            end
            return old(self, ...)
        end))
        Bypass.oldNamecall = old
    end)

    -- Anti-sit / ragdoll (khong goi char() som)
    track(RunService.Heartbeat:Connect(function()
        if not S.bypass or not S.alive then return end
        local c = LP.Character
        if not c then return end
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        pcall(function()
            if hum.Sit then hum.Sit = false end
            local st = hum:GetState()
            if st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end)
    end))

    -- Chan WalkSpeed = 0 khi dang farm
    pcall(function()
        if type(hookmetamethod) ~= "function" then return end
        local oldNew
        local ncc2 = (type(newcclosure) == "function" and newcclosure) or function(f) return f end
        oldNew = hookmetamethod(game, "__newindex", ncc2(function(self, key, value)
            if S.bypass and S.running and typeof(self) == "Instance" then
                local okh, isHum = pcall(function() return self:IsA("Humanoid") end)
                if okh and isHum then
                    if key == "WalkSpeed" or key == "JumpPower" or key == "JumpHeight" then
                        if type(value) == "number" and value < 1 then
