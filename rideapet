local function updateESP()
    if not S.esp then clearESP() return end
    local keep = {}
    for i, egg in ipairs(listEggs(true)) do
        if i > 25 then break end
        keep[egg.ID] = true
        local h = S.highlights[egg.ID]
        if not h then
            local part = Instance.new("Part")
            part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = true, false, false, false
            part.Transparency, part.Size = 1, Vector3.new(1, 1, 1)
            part.Position = egg.Position
            local bb = Instance.new("BillboardGui")
            bb.AlwaysOnTop, bb.Size, bb.StudsOffset = true, UDim2.fromOffset(160, 36), Vector3.new(0, 4, 0)
            bb.Adornee = part
            local tl = Instance.new("TextLabel")
            tl.BackgroundTransparency, tl.Size = 1, UDim2.fromScale(1, 1)
            tl.Font, tl.TextSize, tl.TextStrokeTransparency = Enum.Font.GothamBold, 13, 0.3
            tl.TextColor3 = RarityColors[egg.Rarity] or Color3.new(1, 1, 1)
            tl.Parent = bb
            bb.Parent = part
            part.Parent = workspace
            bb.Parent = espFolder
            h = { part = part, bb = bb, label = tl }
            S.highlights[egg.ID] = h
        end
        local _, _, root = char()
        local d = root and (root.Position - egg.Position).Magnitude or 0
        h.label.Text = string.format("%s [%s]\nLuck %s \194\183 %s \194\183 %dm", egg.Name, egg.Rarity, fmt(egg.Luck), egg.Mutation, d)
        h.part.Position = egg.Position
    end
    for id, h in pairs(S.highlights) do
        if not keep[id] then pcall(function() h.part:Destroy() h.bb:Destroy() end) S.highlights[id] = nil end
    end
end

