local function doServerHop()
    local TeleportService = game:GetService("TeleportService")
    local HttpService = game:GetService("HttpService")
    local placeId = game.PlaceId
    local req = (syn and syn.request) or (http and http.request) or request or http_request
    if not req then
        TeleportService:Teleport(placeId, LP)
        return
    end
    local cursor, servers = "", {}
    for _ = 1, 5 do
        local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s")
            :format(placeId, cursor ~= "" and ("&cursor=" .. cursor) or "")
        local res = req({ Url = url, Method = "GET" })
        if not res or not res.Body then break end
        local data = HttpService:JSONDecode(res.Body)
        if not (data and data.data) then break end
        for _, s in ipairs(data.data) do
            if s.playing and s.maxPlayers and s.id and s.playing < s.maxPlayers and s.id ~= game.JobId then
                table.insert(servers, s)
            end
        end
        cursor = data.nextPageCursor or ""
        if cursor == "" then break end
    end
    if #servers == 0 then
        TeleportService:Teleport(placeId, LP)
        return
    end
    table.sort(servers, function(a, b) return (a.playing or 99) < (b.playing or 99) end)
    local target = servers[math.random(1, math.min(5, #servers))]
    TeleportService:TeleportToPlaceInstance(placeId, target.id, LP)
end
S.doServerHop = doServerHop

