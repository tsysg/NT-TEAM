local function placeEggs()
    if not S.autoPlace then return end
    if not onPlot() then return end
    waitFor(function() return #eggTools() > 0 end, 1.0)
    for _, nest in ipairs(freeNests()) do
        if not S.running then return end
        local tool = eggTools()[1]
        if not tool then return end
        local _, hum = char()
        if hum then hum:EquipTool(tool) end
        task.wait(0.08)
        S.status = "\196\144\225\186\183t egg v\195\160o \225\187\149 " .. nest.Name
        fire("EggPlaced", { NestId = nest.Name })
        if waitFor(function() return nest:GetAttribute("Occupied") end, 1.5) then S.placed = S.placed + 1 end
    end
end

local hatchCd = {}
local function hatchReady()
    if not S.autoHatch or not Services.DayNight or not Data.General then return end
    local plot = getPlot()
    local eggs = plot and plot:FindFirstChild("Eggs")
    if not eggs then return end
    for _, egg in ipairs(eggs:GetChildren()) do
        local info = egg:FindFirstChild("EggData", true)
        local data = Data.Eggs[egg.Name]
        local start = info and info:FindFirstChild("PlaceTime")
        local w = info and info:FindFirstChild("Weight")
        local key = egg:GetAttribute("EggKey")
        if data and start and key and (not hatchCd[key] or os.clock() > hatchCd[key]) then
            local ok, remain = pcall(function()
                local total = Data.General.GrowthTimeFor(data.GrowthTime or 0, w and w.Value or 1)
                return Services.DayNight.GrowthRealRemaining(start.Value, total)
            end)
            if ok and remain and remain <= 0 then
                hatchCd[key] = os.clock() + 5
                local _, _, root = char()
                if root and (root.Position - egg:GetPivot().Position).Magnitude > 12 then
                    moveTo(egg:GetPivot().Position, 6)
                end
                fire("Hatch", { EggKey = key })
                if waitFor(function() return not egg.Parent end, 4) then S.hatched = S.hatched + 1 end
            end
        end
    end
end

