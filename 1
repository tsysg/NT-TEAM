-- Xử lý sự kiện khi bấm nút xác nhận
SubmitBtn.MouseButton1Click:Connect(function()
    local enteredKey = KeyBox.Text
    
    if enteredKey == "NT TEAM" then
        StatusLabel.TextColor3 = Color3.fromRGB(60, 255, 60)
        StatusLabel.Text = "Key chính xác! Đang kết nối..."
        
        task.wait(1)
        
        -- Thông báo Discord và yêu cầu sao chép
        -- Thử sao chép vào bộ nhớ tạm nếu executor hỗ trợ
        pcall(function()
            setclipboard("https://discord.gg/wBZzrtFnC")
        end)
        
        -- Thay đổi giao diện thành thông báo Discord
        KeyBox:Destroy()
        SubmitBtn:Destroy()
        
        Title.Text = "THAM GIA DISCORD NT TEAM"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        StatusLabel.Text = "Link Discord đã được sao chép vào bộ nhớ tạm!"
        
        local LinkBox = Instance.new("TextBox")
        LinkBox.Size = UDim2.new(0.8, 0, 0, 40)
