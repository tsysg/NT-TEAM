-- Thuật toán Server Hop Chuẩn 1 Người
local function serverHopSinglePlayer()
	StatusLabel.Text = "Đang quét danh sách server..."
	StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)

	local success, result = pcall(function()
		local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
		return game:HttpGet(url)
	end)
	
	if success and result then
		local data = HttpService:JSONDecode(result)
		local servers = {}
		
		if data and data.data then
			for _, server in ipairs(data.data) do
				-- Lọc chính xác server có đúng 1 người chơi và không phải server hiện tại
				if type(server) == "table" and server.playing == 1 and server.id ~= JobId then
					table.insert(servers, server.id)
				end
			end
		end
		
		if #servers > 0 then
			local targetServer = servers[math.random(1, #servers)]
			StatusLabel.Text = "Đã tìm thấy! Đang chuyển server..."
			StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
			TeleportService:TeleportToPlaceInstance(PlaceId, targetServer, LocalPlayer)
		else
			StatusLabel.Text = "Không có server 1 người, tìm server ít nhất..."
			StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 0)
			
			-- Dự phòng: Chuyển sang server bất kỳ còn trống chỗ
			local allServers = {}
			if data and data.data then
				for _, server in ipairs(data.data) do
					if type(server) == "table" and server.playing < server.maxPlayers and server.id ~= JobId then
						table.insert(allServers, server.id)
					end
				end
			end
			if #allServers > 0 then
				TeleportService:TeleportToPlaceInstance(PlaceId, allServers[math.random(1, #allServers)], LocalPlayer)
			else
				StatusLabel.Text = "Thất bại: Không có server phù hợp!"
				StatusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
			end
		end
	else
		StatusLabel.Text = "Lỗi kết nối tới Roblox API!"
		StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
	end
end

-- Event Click
HopButton.MouseButton1Click:Connect(serverHopSinglePlayer)
