		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 60
	})

	local Confirm = Create("Frame", {
		Parent = OverlayConfirm,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 300, 0, 145),
		BackgroundColor3 = Color3.fromRGB(20, 20, 23),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 61
	}, {
		Create("UICorner", {CornerRadius = UDim.new(0, 14)}),
		Create("UIStroke", {
			Name = "Stroke",
			Color = Color3.fromRGB(45, 45, 50),
			Transparency = 1,
			Thickness = 1
		})
	})

	Create("TextLabel", {
		Parent = Confirm,
		Size = UDim2.new(1, 0, 0, 50),
		Position = UDim2.new(0, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = "Do you want to delete the menu?",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		ZIndex = 62
	})

	local Yes = Create("TextButton", {
		Parent = Confirm,
		Size = UDim2.new(0, 118, 0, 36),
		Position = UDim2.new(0.5, -126, 0.65, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		Text = "Yes",
		TextColor3 = Color3.fromRGB(16, 16, 18),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		AutoButtonColor = false,
		ZIndex = 62
	}, {
		Create("UICorner", {CornerRadius = UDim.new(0, 9)})
	})

	local No = Create("TextButton", {
		Parent = Confirm,
		Size = UDim2.new(0, 118, 0, 36),
		Position = UDim2.new(0.5, 8, 0.65, 0),
		BackgroundColor3 = Color3.fromRGB(40, 40, 45),
		Text = "No",
		TextColor3 = Color3.fromRGB(220, 220, 225),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		AutoButtonColor = false,
		ZIndex = 62
	}, {
		Create("UICorner", {CornerRadius = UDim.new(0, 9)})
	})

	-- Open animation
	task.spawn(function()
		Tween(Main, 0.45, {
			Size = Size,
			Position = UDim2.new(0.5, -Size.X.Offset / 2, 0.5, -Size.Y.Offset / 2),
			BackgroundTransparency = 0
		}, Enum.EasingStyle.Back):Play()
		Tween(Main.Stroke, 0.4, {Transparency = 0}):Play()
		Tween(Bg, 0.5, {ImageTransparency = 0.3}):Play()
		Tween(Overlay, 0.5, {BackgroundTransparency = 0.35}):Play()

		Tween(LoadTitle, 0.3, {TextTransparency = 0}):Play()
		Tween(LoadStatus, 0.3, {TextTransparency = 0}):Play()
		Tween(BarBg, 0.3, {BackgroundTransparency = 0}):Play()

		LoadStatus.Text = "Welcome"
		task.wait(0.35)
		LoadStatus.Text = "Loading..."

		local t = Tween(BarFill, 0.7, {Size = UDim2.new(1, 0, 1, 0)})
		t:Play()
		t.Completed:Wait()

		LoadStatus.Text = "Ready"
		task.wait(0.3)

		Tween(LoadTitle, 0.25, {TextTransparency = 1}):Play()
		Tween(LoadStatus, 0.25, {TextTransparency = 1}):Play()
		Tween(BarBg, 0.25, {BackgroundTransparency = 1}):Play()
		Tween(BarFill, 0.25, {BackgroundTransparency = 1}):Play()

		Tween(Bg, 0.4, {ImageTransparency = 0.42}):Play()
		Tween(Overlay, 0.4, {BackgroundTransparency = 0.32}):Play()

		Loading.Visible = false
		Topbar.Visible = true
		Content.Visible = true
	end)

	-- Dragging
	local dragging, dragInput, dragStart, startPos
	Topbar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = Main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	Topbar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)

	MinBtn.MouseButton1Click:Connect(function()
		Main.Visible = false
		Float.Visible = true
	end)

	Float.MouseButton1Click:Connect(function()
		Main.Visible = true
		Float.Visible = false
	end)

	CloseBtn.MouseButton1Click:Connect(function()
		OverlayConfirm.Visible = true
		Tween(OverlayConfirm, 0.2, {BackgroundTransparency = 0.45}):Play()
		Tween(Confirm, 0.2, {BackgroundTransparency = 0}):Play()
		Tween(Confirm.Stroke, 0.2, {Transparency = 0}):Play()
	end)

	No.MouseButton1Click:Connect(function()
		Tween(OverlayConfirm, 0.2, {BackgroundTransparency = 1}):Play()
		Tween(Confirm, 0.2, {BackgroundTransparency = 1}):Play()
		Tween(Confirm.Stroke, 0.2, {Transparency = 1}):Play()
		task.wait(0.2)
		OverlayConfirm.Visible = false
	end)

	Yes.MouseButton1Click:Connect(function()
		ScreenGui:Destroy()
	end)

	function Window:Destroy()
		ScreenGui:Destroy()
	end

	table.insert(Library.Windows, Window)
	return Window
end

return Library
