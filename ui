                TextColor3 = Color3.fromRGB(235, 235, 240),
                Font = Enum.Font.Gotham,
                TextSize = 13,
                ZIndex = 13
            }, {
                Create("UICorner", {CornerRadius = UDim.new(0, 10)})
            })

            Box.MouseButton1Click:Connect(function()
                if Callback then Callback() end
            end)
            return Box
        end

        table.insert(Window.Tabs, Tab)
        return Tab
    end

