						Position = UDim2.new(0, 3, 0.5, -8),
						BackgroundColor3 = Color3.fromRGB(160, 160, 165)
					}):Play()
				end
				if Callback then
					task.spawn(Callback, on)
				end
			end

			Box.MouseButton1Click:Connect(function()
				Set(not on)
			end)

			local ToggleObj = {}
			function ToggleObj:Set(v) Set(v) end
			function ToggleObj:Get() return on end
			return ToggleObj
