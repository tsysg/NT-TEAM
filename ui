local Library = {}

function Library:CreateWindow(hubTitle, bgIconId)
    local CoreGui = game:GetService("CoreGui")
    local TweenService = game:GetService("TweenService")
    local Players = game:GetService("Players")
    local UserInputService = game:GetService("UserInputService")
    local RunService = game:GetService("RunService")
    
    local LocalPlayer = Players.LocalPlayer
    local iconAsset = bgIconId or "rbxassetid://120937441097851"

    if CoreGui:FindFirstChild("WaiiHub_UI") then
        CoreGui.WaiiHub_UI:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "WaiiHub_UI"
    ScreenGui.Parent = CoreGui
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true

    local Overlay = Instance.new("Frame")
    Overlay.Name = "Overlay"
    Overlay.Size = UDim2.new(1, 0, 1, 0)
    Overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    Overlay.BackgroundTransparency = 1
    Overlay.BorderSizePixel = 0
    Overlay.Parent = ScreenGui

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 24)
    UICorner.Parent = MainFrame

    -- Floating Toggle Button
    local FloatingToggleBtn = Instance.new("ImageButton")
    FloatingToggleBtn.Name = "FloatingToggleBtn"
    FloatingToggleBtn.Size = UDim2.new(0, 48, 0, 48)
    FloatingToggleBtn.Position = UDim2.new(0, 25, 0.4, 0)
    FloatingToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    FloatingToggleBtn.Image = iconAsset
    FloatingToggleBtn.ScaleType = Enum.ScaleType.Stretch
    FloatingToggleBtn.Parent = ScreenGui

    local FloatCorner = Instance.new("UICorner")
    FloatCorner.CornerRadius = UDim.new(1, 0)
    FloatCorner.Parent = FloatingToggleBtn

    local FloatStroke = Instance.new("UIStroke")
    FloatStroke.Color = Color3.fromRGB(255, 255, 255)
    FloatStroke.Thickness = 1.8
    FloatStroke.Parent = FloatingToggleBtn

    local fDragging, fDragInput, fDragStart, fStartPos, fHasMoved = false, nil, nil, nil, false
    FloatingToggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            fDragging = true
            fHasMoved = false
            fDragStart = input.Position
            fStartPos = FloatingToggleBtn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then fDragging = false end
            end)
        end
    end)

    FloatingToggleBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            fDragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == fDragInput and fDragging then
            local delta = input.Position - fDragStart
            if delta.Magnitude > 5 then fHasMoved = true end
            FloatingToggleBtn.Position = UDim2.new(fStartPos.X.Scale, fStartPos.X.Offset + delta.X, fStartPos.Y.Scale, fStartPos.Y.Offset + delta.Y)
        end
    end)

    -- Notification Popup System
    local NotificationPopup = Instance.new("Frame")
    NotificationPopup.Name = "NotificationPopup"
    NotificationPopup.Size = UDim2.new(0, 240, 0, 44)
    NotificationPopup.Position = UDim2.new(1, 260, 1, -60)
    NotificationPopup.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    NotificationPopup.BackgroundTransparency = 0.1
    NotificationPopup.Parent = ScreenGui

    local NotifPopupCorner = Instance.new("UICorner")
    NotifPopupCorner.CornerRadius = UDim.new(0, 12)
    NotifPopupCorner.Parent = NotificationPopup

    local NotifPopupStroke = Instance.new("UIStroke")
    NotifPopupStroke.Color = Color3.fromRGB(240, 240, 240)
    NotifPopupStroke.Thickness = 1.5
    NotifPopupStroke.Parent = NotificationPopup

    local NotifIcon = Instance.new("ImageLabel")
    NotifIcon.Size = UDim2.new(0, 26, 0, 26)
    NotifIcon.Position = UDim2.new(0, 10, 0.5, -13)
    NotifIcon.BackgroundTransparency = 1
    NotifIcon.Image = iconAsset
    NotifIcon.Parent = NotificationPopup

    local NotifText = Instance.new("TextLabel")
    NotifText.Size = UDim2.new(1, -48, 1, 0)
    NotifText.Position = UDim2.new(0, 44, 0, 0)
    NotifText.BackgroundTransparency = 1
    NotifText.Font = Enum.Font.GothamBold
    NotifText.TextColor3 = Color3.fromRGB(240, 240, 240)
    NotifText.TextSize = 12
    NotifText.TextXAlignment = Enum.TextXAlignment.Left
    NotifText.TextTruncate = Enum.TextTruncate.AtEnd
    NotifText.Parent = NotificationPopup

    local function showNotification(message)
        task.spawn(function()
            NotifText.Text = message
            TweenService:Create(NotificationPopup, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(1, -260, 1, -60)}):Play()
            task.wait(2.2)
            TweenService:Create(NotificationPopup, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 260, 1, -60)}):Play()
        end)
    end

    -- Background Frame
    local MenuBackgroundImage = Instance.new("ImageLabel")
    MenuBackgroundImage.Size = UDim2.new(1, 0, 1, 0)
    MenuBackgroundImage.BackgroundTransparency = 1
    MenuBackgroundImage.Image = iconAsset
    MenuBackgroundImage.ScaleType = Enum.ScaleType.Stretch
    MenuBackgroundImage.ImageTransparency = 0.3
    MenuBackgroundImage.Parent = MainFrame

    local BgImageCorner = Instance.new("UICorner")
    BgImageCorner.CornerRadius = UDim.new(0, 24)
    BgImageCorner.Parent = MenuBackgroundImage

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Color = Color3.fromRGB(255, 255, 255)
    UIStroke.Thickness = 1.8
    UIStroke.Parent = MainFrame

    local StrokeGradient = Instance.new("UIGradient")
    StrokeGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(40, 40, 40)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(15, 15, 15)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(40, 40, 40)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
    })
    StrokeGradient.Parent = UIStroke

    task.spawn(function()
        local rotation = 0
        while MainFrame and MainFrame.Parent do
            rotation = (rotation + 0.5) % 360
            StrokeGradient.Rotation = rotation
            RunService.RenderStepped:Wait()
        end
    end)

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(0, 200, 0, 40)
    Title.Position = UDim2.new(0, 18, 0, 12)
    Title.BackgroundTransparency = 1
    Title.Font = Enum.Font.GothamBold
    Title.Text = '<font color="#FFFFFF">' .. (hubTitle or "Waii Hub") .. '</font>'
    Title.RichText = true
    Title.TextSize = 20
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = MainFrame

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 32, 0, 32)
    CloseBtn.Position = UDim2.new(1, -44, 0, 16)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    CloseBtn.TextSize = 15
    CloseBtn.Parent = MainFrame

    local CloseCorner = Instance.new("UICorner")
    CloseCorner.CornerRadius = UDim.new(1, 0)
    CloseCorner.Parent = CloseBtn

    local MinimizeBtn = Instance.new("TextButton")
    MinimizeBtn.Size = UDim2.new(0, 32, 0, 32)
    MinimizeBtn.Position = UDim2.new(1, -82, 0, 16)
    MinimizeBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    MinimizeBtn.Font = Enum.Font.GothamBold
    MinimizeBtn.Text = "-"
    MinimizeBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    MinimizeBtn.TextSize = 18
    MinimizeBtn.Parent = MainFrame

    local MinimizeCorner = Instance.new("UICorner")
    MinimizeCorner.CornerRadius = UDim.new(1, 0)
    MinimizeCorner.Parent = MinimizeBtn

    -- Sidebar Container
    local SidebarContainer = Instance.new("Frame")
    SidebarContainer.Size = UDim2.new(0, 125, 1, -74)
    SidebarContainer.Position = UDim2.new(0, 18, 0, 56)
    SidebarContainer.BackgroundColor3 = Color3.fromRGB(20, 20, 20) 
    SidebarContainer.BackgroundTransparency = 0.25
    SidebarContainer.Parent = MainFrame

    local SidebarContainerCorner = Instance.new("UICorner")
    SidebarContainerCorner.CornerRadius = UDim.new(0, 16)
    SidebarContainerCorner.Parent = SidebarContainer

    local Sidebar = Instance.new("ScrollingFrame")
    Sidebar.Size = UDim2.new(1, -12, 1, -65)
    Sidebar.Position = UDim2.new(0, 6, 0, 10)
    Sidebar.BackgroundTransparency = 1
    Sidebar.BorderSizePixel = 0
    Sidebar.ScrollBarThickness = 2
    Sidebar.CanvasSize = UDim2.new(0, 0, 0, 180)
    Sidebar.Parent = SidebarContainer

    local SidebarLayout = Instance.new("UIListLayout")
    SidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    SidebarLayout.Padding = UDim.new(0, 6)
    SidebarLayout.Parent = Sidebar

    -- Content Container
    local ContentContainer = Instance.new("Frame")
    ContentContainer.Size = UDim2.new(1, -175, 1, -75)
    ContentContainer.Position = UDim2.new(0, 160, 0, 65)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.ClipsDescendants = true
    ContentContainer.Parent = MainFrame

    -- User Info Avatar
    local AvatarContainer = Instance.new("Frame")
    AvatarContainer.Size = UDim2.new(0, 30, 0, 30)
    AvatarContainer.Position = UDim2.new(0, 8, 1, -38)
    AvatarContainer.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    AvatarContainer.BackgroundTransparency = 0.25
    AvatarContainer.Parent = SidebarContainer

    local AvatarCorner = Instance.new("UICorner")
    AvatarCorner.CornerRadius = UDim.new(1, 0)
    AvatarCorner.Parent = AvatarContainer

    local AvatarImage = Instance.new("ImageLabel")
    AvatarImage.Size = UDim2.new(1, 0, 1, 0)
    AvatarImage.BackgroundTransparency = 1
    AvatarImage.Image = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=150&h=150"
    AvatarImage.Parent = AvatarContainer

    local ImageCorner = Instance.new("UICorner")
    ImageCorner.CornerRadius = UDim.new(1, 0)
    ImageCorner.Parent = AvatarImage

    local UsernameLabel = Instance.new("TextLabel")
    UsernameLabel.Size = UDim2.new(0, 70, 0, 15)
    UsernameLabel.Position = UDim2.new(0, 42, 1, -38)
    UsernameLabel.BackgroundTransparency = 1
    UsernameLabel.Font = Enum.Font.GothamBold
    UsernameLabel.Text = LocalPlayer.Name
    UsernameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    UsernameLabel.TextSize = 11
    UsernameLabel.TextXAlignment = Enum.TextXAlignment.Left
    UsernameLabel.Parent = SidebarContainer

    local TimeLabel = Instance.new("TextLabel")
    TimeLabel.Size = UDim2.new(0, 70, 0, 15)
    TimeLabel.Position = UDim2.new(0, 42, 1, -23)
    TimeLabel.BackgroundTransparency = 1
    TimeLabel.Font = Enum.Font.GothamMedium
    TimeLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
    TimeLabel.TextSize = 10
    TimeLabel.TextXAlignment = Enum.TextXAlignment.Left
    TimeLabel.Parent = SidebarContainer

    task.spawn(function()
        while TimeLabel and TimeLabel.Parent do
            TimeLabel.Text = os.date("%H:%M:%S")
            task.wait(1)
        end
    end)

    -- Draggable Logic
    local dragging, dragInput, dragStart, startPos
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    MainFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Toggle & Minimize
    local isMinimized, isHidden = false, false
    FloatingToggleBtn.MouseButton1Click:Connect(function()
        if fHasMoved then return end
        isHidden = not isHidden
        if isHidden then
            TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)}):Play()
            TweenService:Create(Overlay, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
        else
            Overlay.Visible = true
            TweenService:Create(Overlay, TweenInfo.new(0.3), {BackgroundTransparency = 0.5}):Play()
            TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = isMinimized and UDim2.new(0, 550, 0, 64) or UDim2.new(0, 550, 0, 340)}):Play()
        end
    end)

    MinimizeBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        SidebarContainer.Visible = not isMinimized
        ContentContainer.Visible = not isMinimized
        MinimizeBtn.Text = isMinimized and "+" or "-"
        TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = isMinimized and UDim2.new(0, 550, 0, 64) or UDim2.new(0, 550, 0, 340)}):Play()
    end)

    CloseBtn.MouseButton1Click:Connect(function()
        ScreenGui:Destroy()
    end)

    -- Intro Anim
    TweenService:Create(Overlay, TweenInfo.new(0.3), {BackgroundTransparency = 0.5}):Play()
    TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 550, 0, 340)}):Play()

    -- Window Methods
    local WindowObj = {
        Tabs = {},
        ActiveTab = nil,
        Notify = showNotification
    }

    function WindowObj:CreateTab(tabName)
        local tabOrder = #WindowObj.Tabs + 1

        local tabBtn = Instance.new("TextButton")
        tabBtn.Size = UDim2.new(1, 0, 0, 32)
        tabBtn.BackgroundColor3 = tabOrder == 1 and Color3.fromRGB(240, 240, 240) or Color3.fromRGB(30, 30, 30)
        tabBtn.Font = tabOrder == 1 and Enum.Font.GothamBold or Enum.Font.GothamMedium
        tabBtn.Text = "  " .. tabName
        tabBtn.TextColor3 = tabOrder == 1 and Color3.fromRGB(15, 15, 15) or Color3.fromRGB(160, 160, 160)
        tabBtn.TextSize = 12
        tabBtn.TextXAlignment = Enum.TextXAlignment.Left
        tabBtn.LayoutOrder = tabOrder
        tabBtn.Parent = Sidebar

        local tabCorner = Instance.new("UICorner")
        tabCorner.CornerRadius = UDim.new(0, 10)
        tabCorner.Parent = tabBtn

        local tabContent = Instance.new("ScrollingFrame")
        tabContent.Size = UDim2.new(1, 0, 1, 0)
        tabContent.BackgroundTransparency = 1
        tabContent.BorderSizePixel = 0
        tabContent.ScrollBarThickness = 3
        tabContent.Visible = (tabOrder == 1)
        tabContent.Parent = ContentContainer

        local tabLayout = Instance.new("UIListLayout")
        tabLayout.SortOrder = Enum.SortOrder.LayoutOrder
        tabLayout.Padding = UDim.new(0, 8)
        tabLayout.Parent = tabContent

        tabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            tabContent.CanvasSize = UDim2.new(0, 0, 0, tabLayout.AbsoluteContentSize.Y + 15)
        end)

        local TabObj = { Frame = tabContent }

        function TabObj:CreateSectionRow()
            local rowFrame = Instance.new("Frame")
            rowFrame.Size = UDim2.new(1, -5, 0, 165)
            rowFrame.BackgroundTransparency = 1
            rowFrame.Parent = tabContent

            local rowObj = {}
            function rowObj:CreateSection(title, width, xPosOffset)
                width = width or 178
                xPosOffset = xPosOffset or 0

                local sectionFrame = Instance.new("Frame")
                sectionFrame.Size = UDim2.new(0, width, 0, 160)
                sectionFrame.Position = UDim2.new(0, xPosOffset, 0, 0)
                sectionFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                sectionFrame.BackgroundTransparency = 0.3
                sectionFrame.ClipsDescendants = true
                sectionFrame.Parent = rowFrame

                local sCorner = Instance.new("UICorner")
                sCorner.CornerRadius = UDim.new(0, 10)
                sCorner.Parent = sectionFrame

                local sStroke = Instance.new("UIStroke")
                sStroke.Color = Color3.fromRGB(45, 45, 45)
                sStroke.Thickness = 1.2
                sStroke.Parent = sectionFrame

                local titleLabel = Instance.new("TextLabel")
                titleLabel.Size = UDim2.new(1, -10, 0, 30)
                titleLabel.Position = UDim2.new(0, 10, 0, 0)
                titleLabel.BackgroundTransparency = 1
                titleLabel.Font = Enum.Font.GothamBold
                titleLabel.Text = string.upper(title)
                titleLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
                titleLabel.TextSize = 10.5
                titleLabel.TextXAlignment = Enum.TextXAlignment.Left
                titleLabel.Parent = sectionFrame

                local innerContainer = Instance.new("Frame")
                innerContainer.Size = UDim2.new(1, -12, 1, -35)
                innerContainer.Position = UDim2.new(0, 6, 0, 30)
                innerContainer.BackgroundTransparency = 1
                innerContainer.Parent = sectionFrame

                local innerLayout = Instance.new("UIListLayout")
                innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
                innerLayout.Padding = UDim.new(0, 6)
                innerLayout.Parent = innerContainer

                local SectionObj = {}
                
                -- Nút bấm (Button)
                function SectionObj:CreateButton(btnText, callback)
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(1, 0, 0, 28)
                    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                    btn.Font = Enum.Font.GothamMedium
                    btn.Text = btnText
                    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
                    btn.TextSize = 11
                    btn.Parent = innerContainer

                    local bCorner = Instance.new("UICorner")
                    bCorner.CornerRadius = UDim.new(0, 6)
                    bCorner.Parent = btn

                    btn.MouseButton1Click:Connect(function()
                        if callback then callback() end
                    end)
                end

                -- Công tắc (Toggle)
                function SectionObj:CreateToggle(toggleText, default, callback)
                    local toggled = default or false
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(1, 0, 0, 28)
                    btn.BackgroundColor3 = toggled and Color3.fromRGB(50, 120, 50) or Color3.fromRGB(35, 35, 35)
                    btn.Font = Enum.Font.GothamMedium
                    btn.Text = toggleText .. (toggled and " [ON]" or " [OFF]")
                    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
                    btn.TextSize = 11
                    btn.Parent = innerContainer

                    local bCorner = Instance.new("UICorner")
                    bCorner.CornerRadius = UDim.new(0, 6)
                    bCorner.Parent = btn

                    btn.MouseButton1Click:Connect(function()
                        toggled = not toggled
                        btn.BackgroundColor3 = toggled and Color3.fromRGB(50, 120, 50) or Color3.fromRGB(35, 35, 35)
                        btn.Text = toggleText .. (toggled and " [ON]" or " [OFF]")
                        if callback then callback(toggled) end
                    end)
                end

                return SectionObj
            end
            return rowObj
        end

        tabBtn.MouseButton1Click:Connect(function()
            for _, t in ipairs(WindowObj.Tabs) do
                t.Btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                t.Btn.TextColor3 = Color3.fromRGB(160, 160, 160)
                t.Btn.Font = Enum.Font.GothamMedium
                t.Content.Visible = false
            end
            tabBtn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
            tabBtn.TextColor3 = Color3.fromRGB(15, 15, 15)
            tabBtn.Font = Enum.Font.GothamBold
            tabContent.Visible = true
        end)

        table.insert(WindowObj.Tabs, {Btn = tabBtn, Content = tabContent})
        return TabObj
    end

    return WindowObj
end

return Library
