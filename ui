local NotifyHolder = nil

local function GetNotifyHolder()
	if NotifyHolder and NotifyHolder.Parent then return NotifyHolder end
	local gui = Create("ScreenGui", {
		Name = "WaiiUI_Notify",
		Parent = (typeof(gethui) == "function" and gethui()) or CoreGui,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 99999,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	})
	NotifyHolder = Create("Frame", {
		Parent = gui,
		Size = UDim2.new(0, 300, 1, -40),
		Position = UDim2.new(1, -20, 0, 20),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1
	}, {
		Create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Padding = UDim.new(0, 8)
		})
	})
	return NotifyHolder
end

function Library:Notify(opts)
	opts = opts or {}
	local Title = opts.Title or "Notification"
	local Content = opts.Content or ""
	local Duration = opts.Duration or 4

	local holder = GetNotifyHolder()

	local Frame = Create("Frame", {
		Parent = holder,
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = Color3.fromRGB(22, 22, 26),
		BorderSizePixel = 0,
		ClipsDescendants = true
	}, {
		Create("UICorner", {CornerRadius = UDim.new(0, 10)}),
		Create("UIStroke", {
			Color = Color3.fromRGB(60, 60, 70),
			Thickness = 1,
			Transparency = 0.4
		})
	})

	local TitleLbl = Create("TextLabel", {
		Parent = Frame,
		Size = UDim2.new(1, -20, 0, 20),
		Position = UDim2.new(0, 12, 0, 10),
		BackgroundTransparency = 1,
		Text = Title,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextXAlignment = Enum.TextXAlignment.Left
	})

	local ContentLbl = Create("TextLabel", {
		Parent = Frame,
		Size = UDim2.new(1, -20, 0, 0),
		Position = UDim2.new(0, 12, 0, 32),
		BackgroundTransparency = 1,
		Text = Content,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(180, 180, 190),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y
	})

	task.wait()
	local height = 48 + ContentLbl.TextBounds.Y
	Frame.Size = UDim2.new(1, 0, 0, height)

	Frame.Position = UDim2.new(1, 20, 0, 0)
	Tween(Frame, 0.35, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Quint):Play()

	task.delay(Duration, function()
		local t = Tween(Frame, 0.3, {Position = UDim2.new(1, 40, 0, 0)}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		t:Play()
		t.Completed:Wait()
		Frame:Destroy()
	end)
end

